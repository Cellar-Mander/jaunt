<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Buildingway.Build" />

  <!-- Game-independent logic: no Dalamud reference, so its tests run anywhere, including Linux CI.
       If it needs Json.NET attributes, reference Newtonsoft.Json with PrivateAssets="all"
       ExcludeAssets="runtime": Dalamud loads its own copy, and a second one would carry attribute
       types Dalamud's serializer does not recognise. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
