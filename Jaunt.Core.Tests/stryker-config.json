{
  "stryker-config": {
    "project": "Jaunt.Core.csproj",
    "reporters": [ "progress", "html", "markdown", "json" ],
    "additional-timeout": 1000,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "since": {
      "enabled": false,
      "ignore-changes-in": [ "**/Fixtures/**", "**/Corpus/**" ]
    }
  }
}
