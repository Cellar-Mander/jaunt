<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <Sdk Name="Buildingway.Build" />

  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Cellar Mander</Author>
    <Name>Jaunt</Name>
    <Punchline>Find venues that are open now and travel to them from one list.</Punchline>
    <Description>Lists venues advertised in Party Finder and other sources, with their address, opening times and website, so you can copy the address or travel there from the list.</Description>
    <RepoUrl>https://github.com/Cellar-Mander/jaunt</RepoUrl>
    <!-- At the release tag: repo installs never read images/icon.png from the package -->
    <IconUrl>https://raw.githubusercontent.com/Cellar-Mander/jaunt/v$(Version)/Jaunt/images/icon.png</IconUrl>
    <Tags>venues;roleplay;party finder;travel;housing</Tags>
    <!-- Release builds pass the version's CHANGELOG section as plain text (release.yml); the installer shows it under Changelogs -->
    <Changelog Condition="'$(ChangelogFile)' != ''">$([System.IO.File]::ReadAllText('$(ChangelogFile)').Trim())</Changelog>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add a square PNG (at least 64x64) here before the first release -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('images\icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample cache for the self-tests (SelfTests.cs); SmokeTestListingsTests keeps it in step with docs/smoke-test.md -->
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\marks.json" LogicalName="Jaunt.smoke-test-cache/marks.json" />
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\fetch-state.json" LogicalName="Jaunt.smoke-test-cache/fetch-state.json" />
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\cache\Xivpf.json" LogicalName="Jaunt.smoke-test-cache/cache/Xivpf.json" />
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\cache\FfxivVenues.json" LogicalName="Jaunt.smoke-test-cache/cache/FfxivVenues.json" />
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\cache\Partake.json" LogicalName="Jaunt.smoke-test-cache/cache/Partake.json" />
    <EmbeddedResource Include="..\Jaunt.Core.Tests\Fixtures\smoke-test-cache\cache\RpEventCalendar.json" LogicalName="Jaunt.smoke-test-cache/cache/RpEventCalendar.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaunt.Core\Jaunt.Core.csproj" />
  </ItemGroup>

  <!-- SkiaSharp brings its native library for every platform, each with a ~95 MB PDB. The game is
       always 64-bit Windows, also under Wine and XIV on Mac, so only win-x64's DLL is shipped, as a
       plain native asset beside SkiaSharp.dll rather than under runtimes/: the dev deploy copies only
       the output's top level, and Dalamud loads a native library from where Jaunt.deps.json says. -->
  <Target Name="KeepOnlyWinX64Natives" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_WinX64Natives Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' And '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-x64' And '%(Extension)' == '.dll'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native'" />
      <NativeCopyLocalItems Include="@(_WinX64Natives)" DestinationSubPath="%(Filename)%(Extension)" DestinationSubDirectory="" RuntimeIdentifier="" PathInPackage="%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
